+static void events_emit_error(const char*message){
+  if(!eventsfp)return;
+  char buf[512];
+  snprintf(buf,sizeof(buf),"{\"type\":\"error\",\"schema\":\"alex1770.wordle-events/v1\",\"message\":%s}",json_escape(message).c_str());
+  events_emit(buf);
+}
+
+static void events_emit_result(){
+  if(!eventsfp)return;
+  char buf[768],bestbuf[32],avbuf[32];
+  bool have_best=event_bestfirst>=-1;
+  if(event_bestfirst>=0)snprintf(bestbuf,sizeof(bestbuf),"%d",event_bestfirst);
+  else snprintf(bestbuf,sizeof(bestbuf),"null");
+  if(event_has_result&&!depthonly&&event_objective<infinity&&event_objective>=0){
+    snprintf(avbuf,sizeof(avbuf),"%.6f",(double)event_objective/(double)hiddenwords.size());
+  }else{
+    snprintf(avbuf,sizeof(avbuf),"null");
+  }
+  char obuf[32];
+  if(!event_has_result||event_objective>=infinity)snprintf(obuf,sizeof(obuf),"null");
+  else snprintf(obuf,sizeof(obuf),"%lld",event_objective);
+  snprintf(buf,sizeof(buf),
+    "{\"type\":\"result\",\"schema\":\"alex1770.wordle-events/v1\",\"objective\":%s,\"average\":%s,"
+    "\"best_first\":%s,\"nodes\":%lld,\"time_seconds\":%.2f,\"depthonly\":%s,\"checkpoints\":%lld}",
+    obuf,avbuf,bestbuf,totentries,event_cpu1,depthonly?"true":"false",event_checkpoints);
+  events_emit(buf);
 }

+static void events_emit_completion(const char*reason){
+  if(!eventsfp)return;
+  if(!event_has_result)events_emit_result();
+  char buf[256];
+  snprintf(buf,sizeof(buf),
+    "{\"type\":\"completion\",\"schema\":\"alex1770.wordle-events/v1\",\"status\":\"%s\",\"covered_actions\":%lld,\"declared_actions\":%lu}",
+    reason,event_action_values,(unsigned long)testwords.size());
+  events_emit(buf);
+}
