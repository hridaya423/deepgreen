 #include <fcntl.h>
 #include <unistd.h>

+// ---- local addition: strict JSONL event stream (recorded in UPSTREAM.toml) ----
+static const char*eventsfn=0;
+static FILE*eventsfp=0;
+static long long event_checkpoints=0;
+static long long event_action_values=0;
+static int event_bestfirst=-2;
+static double event_cpu0=0,event_cpu1=0;
+static long long event_objective=0;
+static bool event_has_result=false;
+
+static std::string json_escape(const char*s){
+  std::string out="\"";
+  for(const char*p=s?s:"";*p;p++){
+    unsigned char c=(unsigned char)*p;
+    if(c=='"'||c=='\\'){out+='\\';out+=(char)c;}
+    else if(c<' '){char buf[8];snprintf(buf,sizeof(buf),"\\u%04x",(unsigned)c);out+=buf;}
+    else out+=(char)c;
+  }
+  out+="\"";
+  return out;
+}
+
+static void events_open(){
+  if(!eventsfn)return;
+  eventsfp=fopen(eventsfn,"w");
+  if(!eventsfp){fprintf(stderr,"Cannot open events file %s\n",eventsfn);exit(1);}
+}
+
+static void events_emit(const char*line){
+  if(!eventsfp)return;
+  fputs(line,eventsfp);
+  fputc('\n',eventsfp);
+  fflush(eventsfp);
+}
