# Pinned build environment for the OpenWordle-v1 SCOWL generation step.
# The base image is pinned by digest; apt resolves bookworm's current make 4.3
# and g++ 12.2, matching the environment the frozen constants were measured in.
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

RUN apt-get update \
    && apt-get install -y --no-install-recommends make g++ unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /probe
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["true"]
